{
  "name": "sedrify",
  "version": "0.0.1",
  "description": "Sedrify — Personal database builder",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run use-electron && electron-vite dev",
    "build": "npm run use-electron && electron-vite build",
    "preview": "electron-vite preview",
    "test": "npm run use-node && vitest run",
    "test:watch": "npm run use-node && vitest",
    "test:e2e": "playwright test",
    "use-electron": "node scripts/use-electron-binary.js",
    "use-node": "node scripts/use-node-binary.js",
    "rebuild:electron": "npx @electron/rebuild -v $(cat node_modules/electron/dist/version) -f -w better-sqlite3 && node scripts/save-electron-binary.js",
    "rebuild:node": "cd node_modules/.pnpm/better-sqlite3@11.9.1/node_modules/better-sqlite3 && npm run build-release && cd - && node scripts/save-node-binary.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.44.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.sedrery.app",
    "productName": "Sedrify",
    "directories": { "output": "dist" },
    "linux": { "target": "AppImage", "category": "Office" },
    "win": { "target": "nsis" }
  }
}
